# ===================================================================
# DriveSphere – Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual secrets/credentials.
# Do NOT commit the .env file to version control.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/drivesphere?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JPA / Hibernate Mode (e.g., update, validate, create-drop)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT Configuration (Must be at least 256 bits / 32 characters for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here_example_secret
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI & Location Services
GEMINI_API_KEY=your_gemini_api_key_here
ORS_API_KEY=your_openrouteservice_api_key_here

# Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
