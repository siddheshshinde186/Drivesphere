# ===================================================================
# DriveSphere – Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual secrets/credentials.
# Do NOT commit the .env file to version control.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
# In Docker Compose production:
# - DB_ROOT_PASSWORD is used for the MySQL root superuser.
# - DB_USERNAME must be a non-root application user (e.g., drivesphere_app).
# - DB_PASSWORD is the password for the application user.
DB_ROOT_PASSWORD=your_root_mysql_password_here
DB_NAME=drivesphere
DB_USERNAME=drivesphere_app
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/drivesphere?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JPA / Hibernate Mode (e.g., update, validate, create-drop)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT Configuration (Must be at least 256 bits / 32 characters for HMAC-SHA256)
# You may set either JWT_SECRET or DRIVESPHERE_JWT_SECRET
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here_example_secret
# DRIVESPHERE_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here_example_secret
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI & Location Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
ORS_API_KEY=your_openrouteservice_api_key_here

# Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Demo Data Seeding (false by default for production safety)
DRIVESPHERE_DEMO_DATA_ENABLED=false

# Secure One-Time Initial Admin Provisioning (Optional for first-time production deployment)
# ADMIN_BOOTSTRAP_EMAIL=admin@your-production-domain.com
# ADMIN_BOOTSTRAP_PASSWORD=StrongPasswordMin8Chars!

# SMTP Mail Server Configuration (Required for live transactional emails & password recovery)
# For Gmail: Use smtp.gmail.com, port 587, your Gmail address, and a 16-character App Password (not your account password)
# For SendGrid: Use smtp.sendgrid.net, port 587, username 'apikey', and your SendGrid API key as password
# If unconfigured, DriveSphere runs in safe local dev mode and prints password recovery links directly to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_NEW_GMAIL_APP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=DriveSphere <YOUR_GMAIL_ADDRESS>
FRONTEND_URL=http://localhost:5500


